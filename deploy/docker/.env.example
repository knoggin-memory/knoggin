# Copy to .env and fill in. Compose reads it from this folder.

# The released image, by digest (the release notes give it).
KNOGGIN_IMAGE=ghcr.io/knoggin-memory/knoggin@sha256:<digest>

# The public host name. Caddy gets a certificate for it; the router's public_url is
# https://<this>.
KNOGGIN_DOMAIN=memory.example.com

# tls starts the proxy; local-s3 the bundled SeaweedFS bucket (for trials only).
COMPOSE_PROFILES=tls,local-s3

# The first two parts of the five networks' ranges. A second stack on the same host
# needs another prefix.
KNOGGIN_NET_PREFIX=10.200

# Where make-secrets.sh wrote the secret files.
KNOGGIN_SECRETS_DIR=./secrets
