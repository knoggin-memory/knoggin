{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "signoff": "github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>",
  "packages": {
    ".": {
      "package-name": "knoggin",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "sdk/python/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "json", "path": "ui/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "docs/openapi.json", "jsonpath": "$.info.version" },
        { "type": "json", "path": "integrations/plugin/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "integrations/plugin/.codex-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "integrations/registry/server.json", "jsonpath": "$.version" },
        { "type": "json", "path": "integrations/registry/server.json", "jsonpath": "$.packages[0].version" }
      ]
    }
  }
}
